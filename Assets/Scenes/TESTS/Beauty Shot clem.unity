    - target: {fileID: 535416387345148538, guid: a07913fab27504f4eb3d32518b920809, type: 3}
      propertyPath: 'lines.Array.data[0]'
      value: "Bien dormi <Chichi?> Je t\u2019ai entendue <g\xE9mir> bizarrement pendant
        ton sommeil"
      objectReference: {fileID: 0}
    - target: {fileID: 535416387345148538, guid: a07913fab27504f4eb3d32518b920809, type: 3}
      propertyPath: 'lines.Array.data[1]'
      value: "C'est pas tes affaires,\xA3 t\xEAte de gel\xE9e."
      objectReference: {fileID: 0}
    - target: {fileID: 535416387345148538, guid: a07913fab27504f4eb3d32518b920809, type: 3}
      propertyPath: 'lines.Array.data[2]'
      value: "H\xE9\xE9\xE9\xE9!% C\xB5-c'est pas gentil!..."
      objectReference: {fileID: 0}
    - target: {fileID: 535416387345148538, guid: a07913fab27504f4eb3d32518b920809, type: 3}
      propertyPath: 'lines.Array.data[3]'
      value: "Moi aussi je t'aime bien,\xA3 Chichi."
      objectReference: {fileID: 0}
    - target: {fileID: 535416387345148538, guid: a07913fab27504f4eb3d32518b920809, type: 3}
      propertyPath: 'lines.Array.data[4]'
